# Copy to .env and fill in. Never commit .env: the token is a long-lived secret.
# Pro/Max subscription: run `claude setup-token` on a machine with a browser, paste here
CLAUDE_CODE_OAUTH_TOKEN=

# Optional: host folder to mount as /workspace. Leave unset to use a Docker volume.
# On Linux the folder must be writable by uid 1000 (the container's `node` user).
# PROJECT_DIR=/absolute/path/to/project

# HTTP API (`api` service). Callers send `Authorization: Bearer <API_TOKEN>`.
# Generate one with: openssl rand -hex 32
API_TOKEN=
API_PORT=48271
# Hours after which unmodified workspace files are deleted. 0 keeps them forever.
# Default: 24 with the Docker volume, 0 when PROJECT_DIR is set (so a real project is never cleaned).
# WORKSPACE_RETENTION_HOURS=24
# Asynchronous jobs (POST /jobs): how many run at once, how long one may run, how long a finished one is kept.
# MAX_CONCURRENT_JOBS=2
# JOB_TIMEOUT_SECONDS=3600
# JOB_RETENTION_HOURS=24

# Tools Claude may use without asking when called through the API.
# Bash is needed to convert or generate Word/Excel/PDF files; remove it to forbid shell commands.
CLAUDE_ALLOWED_TOOLS=Read,Edit,Write,Glob,Grep,Bash

# Optional: host folder with extra agents (one folder per agent, each with a CLAUDE.md).
# They are added to the agents in ./agents and win when names clash.
# AGENTS_DIR=/absolute/path/to/agents

# Tools available to agents from sources that are not marked trusted. Keep shell and network tools out of this list.
# UNTRUSTED_TOOLS=Read,Glob,Grep,Write,Edit

# Token for a private agents repository: any variable name, referred to by "tokenEnv" in the sources list.
# MY_AGENTS_TOKEN=

# Secrets for agent tools: any variable set here can be used as ${NAME} in an agent's .mcp.json.
# N8N_TOOLBOX_URL=
# N8N_TOOLBOX_TOKEN=

# Container timezone, e.g. Europe/Zurich. Default UTC.
# TZ=UTC
